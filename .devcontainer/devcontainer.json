{
  "name": "WebRTC Build Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.10"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "postCreateCommand": "sudo .devcontainer/setup-webrtc.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "eamodio.gitlens",
        "zxh404.vscode-proto3"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.associations": {
          "*.gn": "python",
          "*.gni": "python"
        }
      }
    }
  },
  "remoteEnv": {
    "DEPOT_TOOLS_UPDATE": "0",
    "GYP_DEFINES": "target_arch=arm arm_version=7",
    "PATH": "/home/vscode/depot_tools:${PATH}"
  },
  "mounts": [
    "source=webrtc-build-cache,target=/home/vscode/.ccache,type=volume"
  ]
}
